.page {
  padding: 24rpx 24rpx 60rpx;
}

/* —— 模式切换 —— */
.mode-row {
  display: flex;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 22rpx;
}

.mode {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  color: #9AA7B8;
  font-size: 28rpx;
}

.mode-on {
  background: #F0A24A;
  color: #fff;
  font-weight: bold;
}

.search-wrap {
  margin-bottom: 20rpx;
}

.search {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  font-size: 28rpx;
  color: #EAF0F7;
}

.card {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.r-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #F5F8FC;
}

.r-groups {
  font-size: 34rpx;
  color: #FFB86C;
  font-weight: bold;
  margin-top: 12rpx;
}

.r-meta {
  font-size: 24rpx;
  color: #9AA7B8;
  margin-top: 8rpx;
}

.hint {
  font-size: 26rpx;
  color: #8FA0B5;
}

.toolbar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.filter-btn {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 24rpx;
  color: #9AA7B8;
  margin-right: 16rpx;
}

.result-line {
  font-size: 24rpx;
  color: #6E7F94;
}

.state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #8FA0B5;
  font-size: 28rpx;
}

.list {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 20rpx;
  padding: 6rpx 24rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #3A4A5F;
}

.row:last-child {
  border-bottom: none;
}

.row-img {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.row-info {
  margin-left: 20rpx;
  flex: 1;
}

.row-name {
  font-size: 28rpx;
  color: #F5F8FC;
  font-weight: bold;
}

.row-no {
  font-size: 20rpx;
  color: #6E7F94;
  font-weight: normal;
  margin-left: 8rpx;
}

.row-groups {
  margin-top: 6rpx;
}

.g-tag {
  font-size: 20rpx;
  color: #6FB1E8;
  background: rgba(74, 144, 217, 0.15);
  border: 1rpx solid #4A90D9;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
}

.row-attrs {
  font-size: 22rpx;
  color: #9AA7B8;
  margin-top: 6rpx;
}

.sec-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #C6D2E0;
  margin-bottom: 16rpx;
}

.nest {
  margin-bottom: 24rpx;
}

.nest-img {
  width: 100%;
  border-radius: 16rpx;
}

.nest-title {
  font-size: 26rpx;
  color: #EAF0F7;
  margin-top: 10rpx;
}

.nest-tag {
  font-size: 20rpx;
  color: #4CD494;
  margin-left: 12rpx;
}
