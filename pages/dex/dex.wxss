.page {
  padding: 24rpx 24rpx 60rpx;
}

/* —— 搜索 —— */
.search-wrap {
  margin-bottom: 18rpx;
}

.search {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  font-size: 28rpx;
  color: #EAF0F7;
}

/* —— 属性图标行 —— */
.type-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.type-icon {
  width: 18%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.type-on {
  background: rgba(240, 162, 74, 0.12);
}

.type-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
}

.type-dot-more {
  background: #223042;
  border: 1rpx solid #3A4A5F;
  color: #9AA7B8;
  text-align: center;
  line-height: 50rpx;
  font-size: 26rpx;
}

.type-name {
  font-size: 22rpx;
  color: #C6D2E0;
}

.more-row {
  display: flex;
  flex-wrap: wrap;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.type-pill {
  font-size: 24rpx;
  color: #EAF0F7;
  border: 1rpx solid;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin: 6rpx;
}

/* —— 筛选器 —— */
.filter-row {
  display: flex;
  margin-bottom: 14rpx;
}

.filter-row picker {
  flex: 1;
  margin-right: 14rpx;
}

.filter-row picker:last-child {
  margin-right: 0;
}

.filter-btn {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #C6D2E0;
  text-align: center;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
}

.shiny-toggle {
  font-size: 24rpx;
  color: #9AA7B8;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.shiny-on {
  color: #FFD59E;
  border-color: #F0C94A;
  background: rgba(240, 201, 74, 0.12);
}

.count-line {
  font-size: 24rpx;
  color: #6E7F94;
}

/* —— 宫格 —— */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.cell {
  width: 218rpx;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 20rpx;
  padding: 16rpx 12rpx 20rpx;
  margin-bottom: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.cell-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-size: 18rpx;
  font-weight: bold;
  color: #4A3524;
  background: #F0C94A;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.cell-total-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 18rpx;
  font-weight: bold;
  color: #EAF0F7;
  background: #223042;
  border: 1rpx solid #3A4A5F;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.cell-img {
  width: 130rpx;
  height: 130rpx;
  margin-top: 26rpx;
}

.cell-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #F5F8FC;
  margin-top: 8rpx;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #8FA0B5;
  font-size: 28rpx;
}

.end-tip {
  text-align: center;
  color: #6E7F94;
  font-size: 24rpx;
  padding: 24rpx 0;
}
