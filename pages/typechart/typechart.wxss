.page {
  padding: 24rpx 24rpx 60rpx;
}

.step-card {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 18rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
}

.step-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.step-num {
  font-size: 30rpx;
  font-weight: bold;
  color: #F0C94A;
  margin-right: 14rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #F5F8FC;
}

.step-hint {
  font-size: 22rpx;
  color: #8FA0B5;
  margin-bottom: 14rpx;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
}

.type-btn {
  min-width: 130rpx;
  text-align: center;
  background: #223042;
  border: 2rpx solid var(--c, #3A4A5F);
  color: #EAF0F7;
  border-radius: 10rpx;
  padding: 12rpx 0;
  margin: 0 10rpx 10rpx 0;
  font-size: 25rpx;
  font-weight: bold;
}

.type-on {
  background: var(--c, #F0C94A);
  color: #fff;
  border-color: #fff;
  box-shadow: 0 0 0 3rpx rgba(240, 201, 74, 0.4);
}

.type-dis {
  opacity: 0.3;
}

.cur-bar {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 12rpx;
  padding: 18rpx 26rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #C6D2E0;
}

.cur-name {
  color: #F0C94A;
  font-weight: bold;
  font-size: 28rpx;
}

.sec-bar {
  background: #3A2E20;
  color: #F5C842;
  font-size: 28rpx;
  font-weight: bold;
  padding: 14rpx 26rpx;
  border-radius: 12rpx;
  margin: 8rpx 0 12rpx;
}

.card {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 18rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 20rpx;
}

.def-hint {
  font-size: 22rpx;
  color: #8FA0B5;
  margin-bottom: 16rpx;
}

.g-block { margin-bottom: 18rpx; }
.g-block:last-child { margin-bottom: 0; }

.g-title {
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.t-x3 { color: #E74C3C; }
.t-x2 { color: #C0392B; }
.t-x05 { color: #2E7D5B; }
.t-x025 { color: #1B6E4A; }
.t-x0 { color: #888; }

.chips { display: flex; flex-wrap: wrap; }

.chip {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
}

/* 进攻面 */
.atk-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #3A4A5F;
}

.atk-row:last-child { border-bottom: none; }

.atk-def {
  width: 90rpx;
  height: 52rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.atk-vals {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.av {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin: 0 8rpx 6rpx 0;
}

.v-x2 { color: #E74C3C; background: rgba(231, 76, 60, 0.15); font-weight: bold; }
.v-x05 { color: #2E7D5B; background: rgba(46, 125, 91, 0.15); }
.v-x0 { color: #888; background: rgba(0, 0, 0, 0.2); }
.v-x1 { color: #8FA0B5; }

.legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.lg {
  font-size: 21rpx;
  margin-right: 18rpx;
}

.lg-x2 { color: #E74C3C; }
.lg-x1 { color: #8FA0B5; }
.lg-x05 { color: #2E7D5B; }
.lg-x0 { color: #888; }