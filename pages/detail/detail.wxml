<view class="page">

  <view class="state" wx:if="{{loading}}">⏳ 加载中…</view>
  <view class="state" wx:if="{{notFound}}">未找到该精灵</view>

  <block wx:if="{{!loading && spirit}}">

    <!-- ═══ 黄色英雄区（参照站）═══ -->
    <view class="hero">
      <view class="hero-badges">
        <view class="hb-no">No.{{spirit.no}}</view>
        <view class="hb-shiny">{{spirit.shiny ? '异色' : '未知'}}</view>
      </view>
      <image class="hero-img" src="{{spirit.wikiImage || spirit.image}}" mode="aspectFit"></image>
      <view class="hero-swtich">
        <view class="sw-item sw-on">精灵</view>
        <view class="sw-item">果实</view>
        <view class="sw-item">精灵蛋</view>
      </view>
    </view>

    <!-- 名称卡（深色横条） -->
    <view class="namecard">
      <view class="nc-left">
        <view class="nc-name">{{spirit.name}} <text class="nc-trait" wx:if="{{extra.trait}}">{{extra.trait}}</text></view>
        <view class="nc-badges">
          <text class="nc-badge" wx:if="{{spirit.stageText}}">{{spirit.stageText}}</text>
          <text class="nc-badge" wx:if="{{spirit.season && spirit.season !== 'none'}}">{{spirit.season}}</text>
        </view>
        <view class="nc-chips">
          <text class="nc-chip" wx:if="{{extra.h}}">📏 {{extra.h}}</text>
          <text class="nc-chip" wx:if="{{extra.w}}">⚖️ {{extra.w}}</text>
        </view>
      </view>
      <view class="nc-types">
        <text class="nc-type" wx:for="{{spirit.types}}" wx:key="*this"
              style="background: {{typeColor[item]}}">{{item}}</text>
      </view>
    </view>

    <!-- ═══ 种族值 ═══ -->
    <view class="card" wx:if="{{statBars.length > 0}}">
      <view class="sec-row">
        <view class="sec">✨ 种族值</view>
        <view class="sec-total" wx:if="{{total}}">{{total}}</view>
      </view>
      <view class="stat-row" wx:for="{{statBars}}" wx:key="key">
        <view class="stat-label">{{item.label}}</view>
        <view class="stat-bar-bg">
          <view class="stat-bar" style="width: {{item.pct}}%; background: {{item.color}}"></view>
        </view>
        <view class="stat-value">{{item.value}}</view>
      </view>
    </view>

    <!-- ═══ 精灵资质 ═══ -->
    <view class="card">
      <view class="sec">🎴 精灵资质</view>
      <view class="qual-row">
        <view class="qual-item">
          <text class="qual-k">⭐ 星光值</text>
          <text class="qual-v">{{extra.star || '-'}}</text>
        </view>
        <view class="qual-item">
          <text class="qual-k">🪙 洛克贝</text>
          <text class="qual-v">{{extra.review || '-'}}</text>
        </view>
      </view>
      <view class="trait-block" wx:if="{{extra.trait}}">
        <view class="trait-name">特性 · {{extra.trait}}</view>
        <view class="trait-desc">{{extra.traitDesc}}</view>
      </view>
      <view class="obtain-row" wx:if="{{extra.obtain}}">
        <text class="obtain-k">获取方式</text>
        <text class="obtain-v">{{extra.obtain}}</text>
      </view>
      <view class="obtain-row" wx:if="{{eggGroup}}">
        <text class="obtain-k">蛋组</text>
        <text class="obtain-v">{{eggGroup}}</text>
      </view>
      <view class="obtain-row" wx:if="{{wikiKind}}">
        <text class="obtain-k">种类</text>
        <text class="obtain-v">{{wikiKind}}</text>
      </view>
    </view>

    <!-- ═══ 性格推荐（WIKI 数据）═══ -->
    <view class="card" wx:if="{{natures.length > 0}}">
      <view class="sec">🧠 性格推荐</view>
      <view class="nature-row" wx:for="{{natures}}" wx:key="name">
        <view class="nature-main">
          <text class="nature-name">{{item.name}}</text>
          <text class="nature-detail">{{item.detail}}</text>
        </view>
        <text class="nature-pct">{{item.pct}}</text>
      </view>
    </view>

    <!-- ═══ 进化链 ═══ -->
    <view class="card" wx:if="{{family.length > 1}}">
      <view class="sec-row">
        <view class="sec">🔗 进化链</view>
      </view>
      <scroll-view scroll-x class="fam-scroll">
        <view class="fam-row">
          <block wx:for="{{family}}" wx:key="name">
            <view class="fam-item {{item.name === spirit.name ? 'fam-cur' : ''}}"
                  data-name="{{item.name}}" bindtap="onFamilyTap">
              <image class="fam-img" src="{{item.image}}" mode="aspectFit" lazy-load="true"></image>
              <view class="fam-name">{{item.name}}</view>
            </view>
            <view class="fam-arrow" wx:if="{{index < family.length - 1}}">→</view>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- ═══ 属性克制（攻/防双 tab）═══ -->
    <view class="card" wx:if="{{atkGroups}}">
      <view class="sec">⚔️ 属性克制</view>
      <view class="tab-row">
        <view class="tab {{tab === 0 ? 'tab-on' : ''}}" data-idx="0" bindtap="onTab">作为进攻方</view>
        <view class="tab {{tab === 1 ? 'tab-on' : ''}}" data-idx="1" bindtap="onTab">作为防守方</view>
      </view>

      <block wx:if="{{tab === 0}}">
        <view class="g-block" wx:if="{{atkGroups.x2.length}}">
          <view class="g-title t-strong">2倍克制</view>
          <view class="chips">
            <text class="chip" wx:for="{{atkGroups.x2}}" wx:key="*this"
                  style="background: {{typeColor[item]}}">{{item}}</text>
          </view>
        </view>
        <view class="g-block" wx:if="{{atkGroups.x05.length}}">
          <view class="g-title t-weak">1/2倍克制</view>
          <view class="chips">
            <text class="chip" wx:for="{{atkGroups.x05}}" wx:key="*this"
                  style="background: {{typeColor[item]}}">{{item}}</text>
          </view>
        </view>
      </block>

      <block wx:if="{{tab === 1}}">
        <view class="g-block" wx:if="{{defGroups.x2.length}}">
          <view class="g-title t-strong">受到 2倍克制</view>
          <view class="chips">
            <text class="chip" wx:for="{{defGroups.x2}}" wx:key="*this"
                  style="background: {{typeColor[item]}}">{{item}}</text>
          </view>
        </view>
        <view class="g-block" wx:if="{{defGroups.x05.length}}">
          <view class="g-title t-resist">受到 1/2倍伤害</view>
          <view class="chips">
            <text class="chip" wx:for="{{defGroups.x05}}" wx:key="*this"
                  style="background: {{typeColor[item]}}">{{item}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- ═══ 技能（三标签 + 属性筛选 + 卡片）═══ -->
    <view class="card">
      <view class="sec">📖 技能</view>
      <view class="tab-row">
        <view class="tab {{skillSrc === index ? 'tab-on' : ''}}"
              wx:for="{{skillSrcList}}" wx:key="key" wx:for-index="index"
              data-idx="{{index}}" bindtap="onSkillSrcTap">{{item.label}}[{{index === 0 ? skillTotal : ''}}]</view>
      </view>

      <view class="skill-filters" wx:if="{{skillTypes.length > 1}}">
        <view class="sfilter {{skillFilter === item ? 'sfilter-on' : ''}}"
              wx:for="{{skillTypes}}" wx:key="*this"
              data-f="{{item}}" bindtap="onSkillFilter">{{item}}</view>
      </view>

      <view class="skill" wx:for="{{skills}}" wx:key="name">
        <view class="sk-head">
          <image class="sk-ico" src="" mode="aspectFit"></image>
          <text class="sk-name">{{item.name}}</text>
          <text class="sk-cost" wx:if="{{item.cost}}">✦ 耗能 {{item.cost}}</text>
          <text class="sk-power" wx:if="{{item.power && item.power !== '0'}}">威力 {{item.power}}</text>
          <text class="sk-cat">{{item.cat}}</text>
        </view>
        <view class="sk-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
      </view>
      <view class="empty" wx:if="{{skills.length === 0}}">技能数据加载中，或该精灵暂未收录</view>
    </view>

    <!-- ═══ 简介（WIKI 优先，参照站兜底）═══ -->
    <view class="card" wx:if="{{wikiDesc || extra.desc}}">
      <view class="sec">📝 简介</view>
      <view class="desc">{{wikiDesc || extra.desc}}</view>
    </view>

  </block>

</view>
