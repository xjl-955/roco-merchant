.page {
  padding: 24rpx 24rpx 60rpx;
}

/* —— 搜索 —— */
.search-wrap {
  margin-bottom: 18rpx;
}

.search {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  font-size: 28rpx;
  color: #EAF0F7;
}

/* —— 属性图标行 —— */
.type-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.type-icon {
  width: 18%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.type-on {
  background: rgba(240, 162, 74, 0.12);
  border-color: #F0A24A;
}

.type-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.25);
}

.type-dot-more {
  background: #223042;
  border: 1rpx solid #3A4A5F;
  color: #9AA7B8;
  text-align: center;
  line-height: 48rpx;
  font-size: 26rpx;
}

.type-name {
  font-size: 22rpx;
  color: #C6D2E0;
}

.more-row {
  display: flex;
  flex-wrap: wrap;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.type-pill {
  font-size: 24rpx;
  color: #EAF0F7;
  border: 1rpx solid;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  margin: 6rpx;
}

/* —— 筛选行 —— */
.filter-row {
  display: flex;
  margin-bottom: 14rpx;
}

.filter-row picker {
  flex: 1;
  margin-right: 14rpx;
}

.filter-row picker:last-child {
  margin-right: 0;
}

.filter-btn {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 14rpx;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  color: #C6D2E0;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.filter-on {
  color: #FFD59E;
  border-color: #F0C94A;
  background: rgba(240, 201, 74, 0.12);
}

.meta-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 0 6rpx;
}

.count-line {
  font-size: 24rpx;
  color: #6E7F94;
}

/* —— 宫格（参照站风） —— */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.cell {
  width: 218rpx;
  margin-bottom: 20rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  position: relative;
}

.cell-stage {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 18rpx;
  font-weight: bold;
  color: #FFD59E;
  background: rgba(34, 48, 66, 0.9);
  padding: 4rpx 12rpx;
  border-bottom-left-radius: 12rpx;
  z-index: 2;
}

.cell-imgwrap {
  position: relative;
  height: 190rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #33445C 0%, #2C3A4D 100%);
}

.cell-img {
  width: 150rpx;
  height: 150rpx;
}

.cell-no {
  position: absolute;
  left: 10rpx;
  bottom: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #4A3524;
  background: #F0C94A;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.cell-namebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #223042;
  padding: 10rpx 12rpx;
  border-top: 1rpx solid #3A4A5F;
}

.cell-name {
  font-size: 25rpx;
  font-weight: bold;
  color: #F5F8FC;
  max-width: 130rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-types {
  display: flex;
}

.cell-type {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-left: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #8FA0B5;
  font-size: 28rpx;
}

.end-tip {
  text-align: center;
  color: #6E7F94;
  font-size: 24rpx;
  padding: 24rpx 0;
}
