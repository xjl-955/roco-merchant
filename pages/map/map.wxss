.page {
  padding: 0;
  height: 100vh;
  overflow: hidden;
}

.head { padding: 30rpx 28rpx 20rpx; }
.head-title { font-size: 38rpx; font-weight: bold; color: #F5F8FC; }
.head-sub { font-size: 24rpx; color: #8FA0B5; margin-top: 8rpx; }

.cat-list { padding: 0 24rpx; }

.cat-item {
  display: flex;
  align-items: center;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
}

.cat-icon { font-size: 44rpx; margin-right: 22rpx; }
.cat-info { flex: 1; }
.cat-name { font-size: 30rpx; font-weight: bold; color: #F5F8FC; }
.cat-count { font-size: 22rpx; color: #8FA0B5; margin-top: 4rpx; }
.cat-arrow { font-size: 40rpx; color: #6E7F94; }

.toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
}

.tb-back { color: #F0C94A; font-size: 28rpx; padding: 8rpx 20rpx 8rpx 0; }
.tb-title { flex: 1; font-size: 30rpx; font-weight: bold; color: #F5F8FC; }

.zoom-btns {
  display: flex;
  align-items: center;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 12rpx;
  overflow: hidden;
}

.zoom-btn {
  width: 64rpx;
  height: 56rpx;
  text-align: center;
  line-height: 52rpx;
  font-size: 34rpx;
  color: #F0C94A;
  font-weight: bold;
}

.zoom-num {
  min-width: 70rpx;
  text-align: center;
  font-size: 24rpx;
  color: #C6D2E0;
  border-left: 1rpx solid #3A4A5F;
  border-right: 1rpx solid #3A4A5F;
  height: 56rpx;
  line-height: 56rpx;
}

.floor-tabs {
  display: flex;
  padding: 0 20rpx 14rpx;
}

.floor-tab {
  flex: 1;
  text-align: center;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 10rpx;
  padding: 14rpx 0;
  margin-right: 12rpx;
  font-size: 25rpx;
  color: #C6D2E0;
}

.floor-tab:last-child { margin-right: 0; }

.floor-on {
  background: #F0C94A;
  color: #3A2E20;
  font-weight: bold;
  border-color: #F0C94A;
}

.sub-scroll {
  white-space: nowrap;
  padding: 0 20rpx 14rpx;
}

.sub-row { display: inline-flex; }

.sub-chip {
  font-size: 23rpx;
  color: #C6D2E0;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  margin-right: 12rpx;
}

.sub-on {
  color: #3A2E20;
  background: #F0C94A;
  font-weight: bold;
  border-color: #F0C94A;
}

.map-area {
  width: 100%;
  height: calc(100vh - 400rpx);
  overflow: hidden;
  background: #dfd4c5;
  position: relative;
}

.map-mover {
  /* movable-view：由组件控制位置 */
}

.map-canvas {
  position: relative;
  transform-origin: 0 0;
}

.tile-grid {
  display: grid;
  grid-template-columns: repeat(8, 12.5%);
  grid-template-rows: repeat(8, 12.5%);
  width: 100%;
  height: 100%;
}

.tile { width: 100%; height: 100%; }

.marker {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  margin-left: -20rpx;
  margin-top: -40rpx;
  z-index: 5;
}

.mk-icon {
  width: 40rpx;
  height: 40rpx;
  filter: drop-shadow(0 2rpx 3rpx rgba(0, 0, 0, 0.7));
}

.info-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  z-index: 50;
}

.ib-tip {
  text-align: center;
  color: #8FA0B5;
  font-size: 23rpx;
}

.ib-close {
  position: absolute;
  right: 20rpx;
  top: 14rpx;
  color: #8FA0B5;
  font-size: 28rpx;
  padding: 4rpx 10rpx;
}

.ib-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #F5F8FC;
  padding-right: 50rpx;
}

.ib-meta {
  font-size: 22rpx;
  color: #F0C94A;
  margin-top: 6rpx;
}

.ib-floor { color: #8FA0B5; }

.ib-desc {
  font-size: 24rpx;
  color: #C6D2E0;
  margin-top: 8rpx;
  line-height: 1.5;
}

.state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #8FA0B5;
  font-size: 28rpx;
}