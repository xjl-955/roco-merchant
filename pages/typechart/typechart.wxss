.page {
  padding: 24rpx 24rpx 60rpx;
}

.mode-row {
  display: flex;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 999rpx;
  padding: 6rpx;
}

.mode {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  color: #9AA7B8;
  font-size: 28rpx;
}

.mode-on {
  background: #F0A24A;
  color: #fff;
  font-weight: bold;
}

.hint {
  font-size: 26rpx;
  color: #8FA0B5;
  margin: 20rpx 6rpx;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
}

.type {
  width: 20%;
  text-align: center;
  margin: 1.5%;
  padding: 16rpx 0;
  border-radius: 12rpx;
  border: 2rpx solid;
  color: #F5F8FC;
  font-size: 26rpx;
  font-weight: bold;
  box-sizing: border-box;
}

.card {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  margin-top: 18rpx;
}

.g-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.t-x4 { color: #E8634C; }
.t-x2 { color: #F0A24A; }
.t-x05 { color: #4CD494; }
.t-x0 { color: #6FB1E8; }
.t-x1 { color: #9AA7B8; }

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  font-size: 24rpx;
  color: #F5F8FC;
  background: #223042;
  border: 1rpx solid #3A4A5F;
  border-radius: 10rpx;
  padding: 6rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
}

.chip-gray {
  color: #9AA7B8;
}
