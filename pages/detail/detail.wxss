.page {
  padding: 0 0 60rpx;
}

/* 板块分隔条（基础信息/技能表/进化链/图鉴课题） */
.sec-bar {
  background: #3A2E20;
  color: #F5C842;
  font-size: 30rpx;
  font-weight: bold;
  padding: 16rpx 28rpx;
  margin: 24rpx 24rpx 4rpx;
  border-radius: 14rpx 14rpx 0 0;
  letter-spacing: 2rpx;
}

.plain-text {
  font-size: 26rpx;
  color: #3A2E20;
  line-height: 1.7;
}

/* 图鉴课题 */
.quest-row {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border: 2rpx solid #3A2E20;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 10rpx;
}

.quest-row:last-child { margin-bottom: 0; }

.quest-no {
  font-size: 26rpx;
  font-weight: bold;
  color: #B0413E;
  width: 56rpx;
  flex-shrink: 0;
}

.quest-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.quest-text {
  font-size: 26rpx;
  color: #3A2E20;
  font-weight: bold;
  line-height: 1.4;
}

.quest-reward {
  font-size: 22rpx;
  color: #6B5D45;
  margin-top: 4rpx;
}

.card {
  background: #FFF6E0;
  border: 2rpx solid #3A2E20;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 4rpx 4rpx 0 rgba(58, 46, 32, 0.9);
}

.state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #8FA0B5;
  font-size: 28rpx;
}

/* ═══ 黄色英雄区 ═══ */
.hero {
  background: #F5C842;
  padding: 30rpx 24rpx 24rpx;
  position: relative;
  border-bottom: 3rpx solid #3A2E20;
}

.hero-badges {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.hb-no {
  font-size: 26rpx;
  font-weight: bold;
  color: #3A2E20;
  background: #fff;
  border: 2rpx solid #3A2E20;
  border-radius: 10rpx;
  padding: 4rpx 16rpx;
}

.hb-shiny {
  font-size: 26rpx;
  font-weight: bold;
  color: #3A2E20;
  background: #fff;
  border: 2rpx solid #3A2E20;
  border-radius: 10rpx;
  padding: 4rpx 16rpx;
}

.hero-img {
  width: 340rpx;
  height: 340rpx;
  display: block;
  margin: 10rpx auto 16rpx;
}

.hero-swtich {
  display: flex;
  background: #3A2E20;
  border-radius: 14rpx;
  overflow: hidden;
  margin: 0 60rpx;
}

.sw-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  color: #E8DCC8;
  font-size: 26rpx;
  font-weight: bold;
}

.sw-on {
  background: #F5C842;
  color: #3A2E20;
}

/* ═══ 名称卡（深色横条） ═══ */
.namecard {
  background: #2C3A4D;
  margin: 20rpx 24rpx;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nc-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.nc-trait {
  font-size: 24rpx;
  color: #F5C842;
  margin-left: 12rpx;
}

.nc-badges {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.nc-badge {
  font-size: 22rpx;
  color: #C6D2E0;
  background: #223042;
  border: 1rpx solid #3A4A5F;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 10rpx;
}

.nc-chips {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.nc-chip {
  font-size: 22rpx;
  color: #9AA7B8;
  margin-right: 20rpx;
}

.nc-types {
  display: flex;
  flex-direction: column;
}

.nc-type {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  margin: 4rpx 0;
  text-align: center;
  min-width: 80rpx;
}

/* ═══ 通用卡片头 ═══ */
.sec-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sec {
  font-size: 30rpx;
  font-weight: bold;
  color: #3A2E20;
}

.sec-total {
  font-size: 34rpx;
  font-weight: bold;
  color: #3A2E20;
  background: #fff;
  border: 2rpx solid #3A2E20;
  border-radius: 12rpx;
  padding: 2rpx 18rpx;
}

/* ═══ 种族值 ═══ */
.stat-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.stat-row:last-child { margin-bottom: 0; }

.stat-label {
  width: 90rpx;
  font-size: 25rpx;
  font-weight: bold;
  color: #6B5D45;
  flex-shrink: 0;
}

.stat-bar-bg {
  flex: 1;
  height: 24rpx;
  background: #EDE3C8;
  border: 2rpx solid #3A2E20;
  border-radius: 999rpx;
  overflow: hidden;
}

.stat-bar {
  height: 100%;
  border-radius: 999rpx;
}

.stat-value {
  width: 80rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: bold;
  color: #3A2E20;
  flex-shrink: 0;
}

/* ═══ 精灵资质 ═══ */
.qual-row {
  display: flex;
  margin-bottom: 18rpx;
}

.qual-item {
  flex: 1;
  background: #fff;
  border: 2rpx solid #3A2E20;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qual-item:last-child { margin-right: 0; }

.qual-k {
  font-size: 24rpx;
  color: #6B5D45;
  font-weight: bold;
}

.qual-v {
  font-size: 28rpx;
  color: #3A2E20;
  font-weight: bold;
}

.trait-block {
  background: rgba(245, 200, 66, 0.35);
  border: 2rpx solid #3A2E20;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}

.trait-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #B0413E;
  margin-bottom: 6rpx;
}

.trait-desc {
  font-size: 25rpx;
  color: #3A2E20;
  line-height: 1.5;
}

.obtain-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 2rpx solid #3A2E20;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
}

.obtain-k {
  font-size: 24rpx;
  color: #6B5D45;
  font-weight: bold;
}

.obtain-v {
  font-size: 25rpx;
  color: #3A2E20;
  font-weight: bold;
}

/* ═══ 进化链 ═══ */
.fam-scroll { white-space: nowrap; }

.fam-row {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 0;
}

.fam-item {
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border: 2rpx solid #3A2E20;
  border-radius: 16rpx;
  padding: 12rpx 8rpx;
  flex-shrink: 0;
}

.fam-cur {
  background: #F5C842;
}

.fam-img {
  width: 100rpx;
  height: 100rpx;
}

.fam-name {
  font-size: 22rpx;
  font-weight: bold;
  color: #3A2E20;
  margin-top: 6rpx;
  max-width: 130rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fam-arrow {
  font-size: 36rpx;
  color: #B0413E;
  font-weight: bold;
  margin: 0 10rpx;
}

/* ═══ 克制 ═══ */
.tab-row {
  display: flex;
  background: #EDE3C8;
  border: 2rpx solid #3A2E20;
  border-radius: 12rpx;
  padding: 4rpx;
  margin-bottom: 18rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  color: #6B5D45;
  font-size: 26rpx;
  font-weight: bold;
}

.tab-on {
  background: #F5C842;
  color: #3A2E20;
}

.g-block { margin-bottom: 18rpx; }
.g-block:last-child { margin-bottom: 0; }

.g-title {
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.t-strong { color: #B0413E; }
.t-weak { color: #4A7C59; }
.t-resist { color: #2C6E8A; }

.chips { display: flex; flex-wrap: wrap; }

.chip {
  font-size: 24rpx;
  font-weight: bold;
  color: #fff;
  border: 2rpx solid #3A2E20;
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
}

/* ═══ 技能 ═══ */
.skill-filters {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}

.sfilter {
  font-size: 22rpx;
  color: #6B5D45;
  background: #fff;
  border: 2rpx solid #3A2E20;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  margin: 0 10rpx 10rpx 0;
}

.sfilter-on {
  background: #F5C842;
  color: #3A2E20;
  font-weight: bold;
}

.skill {
  padding: 16rpx 0;
  border-bottom: 2rpx dashed #D4C7A8;
}

.skill:last-child { border-bottom: none; }

.sk-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.sk-ico {
  width: 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  background: #EDE3C8;
  margin-right: 12rpx;
}

.sk-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #3A2E20;
  margin-right: 14rpx;
}

.sk-cost {
  font-size: 22rpx;
  color: #4A7C59;
  background: #fff;
  border: 1rpx solid #3A2E20;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
}

.sk-power {
  font-size: 22rpx;
  color: #B0413E;
  background: #fff;
  border: 1rpx solid #3A2E20;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
}

.sk-cat {
  font-size: 22rpx;
  color: #6B5D45;
  background: #EDE3C8;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.sk-desc {
  font-size: 24rpx;
  color: #6B5D45;
  margin-top: 8rpx;
  margin-left: 60rpx;
  line-height: 1.5;
}

.empty {
  text-align: center;
  color: #9C8E72;
  font-size: 26rpx;
  padding: 24rpx 0;
}

/* ═══ 性格推荐 ═══ */
.nature-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border: 2rpx solid #3A2E20;
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 10rpx;
}

.nature-row:last-child { margin-bottom: 0; }

.nature-main {
  display: flex;
  align-items: center;
}

.nature-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #3A2E20;
  margin-right: 14rpx;
}

.nature-detail {
  font-size: 22rpx;
  color: #B0413E;
}

.nature-pct {
  font-size: 24rpx;
  font-weight: bold;
  color: #6B5D45;
}

/* ═══ 简介 ═══ */
.desc {
  font-size: 26rpx;
  color: #3A2E20;
  line-height: 1.7;
}
