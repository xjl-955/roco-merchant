<view class="page">

  <view class="state" wx:if="{{loading}}">⏳ 地图资源加载中…</view>
  <view class="state" wx:if="{{error}}">加载失败，请检查网络后重试</view>

  <!-- ═══ 分类选择（未选分类时）═══ -->
  <block wx:if="{{!loading && !error && !activeCat}}">
    <view class="head">
      <view class="head-title">🗺️ 世界地图资源</view>
      <view class="head-sub">共 7148 个点位 · 点位宝箱 / 采集 / 采矿 / 精灵聚集地</view>
    </view>

    <view class="cat-list">
      <view class="cat-item" wx:for="{{cats}}" wx:key="name"
            data-name="{{item.name}}" bindtap="onCatTap">
        <text class="cat-icon">{{item.icon}}</text>
        <view class="cat-info">
          <view class="cat-name">{{item.name}}</view>
          <view class="cat-count">{{item.count}} 个点位</view>
        </view>
        <view class="cat-arrow">›</view>
      </view>
    </view>
  </block>

  <!-- ═══ 点位浏览（已选分类）═══ -->
  <block wx:if="{{!loading && !error && activeCat}}">

    <!-- 搜索 + 子分类筛选 -->
    <view class="filter-zone">
      <input class="search" placeholder="搜索点位名称"
             value="{{keyword}}" bindinput="onSearchInput" />

      <scroll-view scroll-x class="sub-scroll" wx:if="{{subs.length > 1}}">
        <view class="sub-row">
          <view class="sub-chip {{activeSub === '' ? 'sub-on' : ''}}"
                data-sub="" bindtap="onSubTap">全部</view>
          <view class="sub-chip {{activeSub === item.name ? 'sub-on' : ''}}"
                wx:for="{{subs}}" wx:key="name"
                data-sub="{{item.name}}" bindtap="onSubTap">{{item.name}} {{item.count}}</view>
        </view>
      </scroll-view>
    </view>

    <!-- 点位列表 -->
    <view class="count-line">共 {{total}} 个点位</view>
    <view class="point-list">
      <view class="point" wx:for="{{list}}" wx:key="index"
            data-key="{{index}}" bindtap="onPointTap">
        <view class="point-head">
          <text class="point-name">{{item.name}}</text>
          <text class="point-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
        </view>
        <view class="point-desc" wx:if="{{expanded === index && item.desc}}">{{item.desc}}</view>
        <view class="point-floor" wx:if="{{item.floor}}">楼层 {{item.floor}}</view>
      </view>
    </view>

    <view class="empty" wx:if="{{list.length === 0}}">没有匹配的点位</view>
  </block>

</view>
