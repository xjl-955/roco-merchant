.page {
  padding: 24rpx 24rpx 60rpx;
}

.state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #8FA0B5;
  font-size: 28rpx;
}

.tip-card {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 16rpx;
  padding: 20rpx 26rpx;
  margin-bottom: 16rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #F5F8FC;
}

.tip-desc {
  font-size: 22rpx;
  color: #8FA0B5;
  margin-top: 6rpx;
}

.matrix-scroll {
  width: 100%;
  white-space: nowrap;
}

.matrix {
  display: inline-block;
  min-width: 100%;
}

.m-row {
  display: flex;
}

.m-cell {
  min-width: 110rpx;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  font-size: 24rpx;
  color: #EAF0F7;
  padding: 6rpx 10rpx;
  text-align: center;
}

.m-header .m-axis {
  color: #F0C94A;
}

.m-row:not(.m-header) .m-axis.is-up {
  color: #E0765A;
}

.m-axis {
  background: #223042;
  font-weight: bold;
  color: #F0C94A;
}

.m-na {
  color: #4A5A6E;
  background: #22303E;
}

.m-link {
  color: #F0C94A;
  font-weight: bold;
}

.card {
  background: #2C3A4D;
  border: 1rpx solid #3A4A5F;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.d-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #F0C94A;
}

.d-line {
  display: flex;
  margin-top: 10rpx;
}

.d-up { color: #E0765A; font-size: 26rpx; margin-right: 24rpx; }
.d-down { color: #5A9BD4; font-size: 26rpx; }

.d-tags-title {
  font-size: 24rpx;
  color: #8FA0B5;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.d-tags {
  display: flex;
  flex-wrap: wrap;
}

.d-tag {
  font-size: 22rpx;
  color: #C6D2E0;
  background: #223042;
  border: 1rpx solid #3A4A5F;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin: 0 10rpx 10rpx 0;
}
