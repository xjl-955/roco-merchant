<view class="page">

  <view class="state" wx:if="{{loading}}">⏳ 地图加载中…</view>
  <view class="state" wx:if="{{error}}">加载失败，请检查网络</view>

  <!-- ═══ 分类选择（首屏）═══ -->
  <block wx:if="{{!loading && !error && !mapMode}}">
    <view class="head">
      <view class="head-title">🗺️ 世界地图</view>
      <view class="head-sub">7148 个点位 · 点击分类查看地图</view>
    </view>

    <view class="cat-list">
      <view class="cat-item" wx:for="{{cats}}" wx:key="name"
            data-name="{{item.name}}" bindtap="onCatTap">
        <text class="cat-icon">{{item.icon}}</text>
        <view class="cat-info">
          <view class="cat-name">{{item.name}}</view>
          <view class="cat-count">{{item.count}} 个点位</view>
        </view>
        <view class="cat-arrow">›</view>
      </view>
    </view>
  </block>

  <!-- ═══ 互动地图（已选分类）═══ -->
  <block wx:if="{{mapMode}}">

    <view class="toolbar">
      <view class="tb-back" bindtap="onBackCats">‹ 分类</view>
      <view class="tb-title">{{activeCatIcon}} {{activeCat}}</view>
      <view class="zoom-btns">
        <view class="zoom-btn" bindtap="onZoomOut">−</view>
        <view class="zoom-num">{{zoom}}x</view>
        <view class="zoom-btn" bindtap="onZoomIn">＋</view>
      </view>
    </view>

    <view class="floor-tabs">
      <view class="floor-tab {{activeFloor === 'G' ? 'floor-on' : ''}}"
            data-floor="G" bindtap="onFloorTap">🗺️ 大地图</view>
      <view class="floor-tab {{activeFloor === 'B1' ? 'floor-on' : ''}}"
            data-floor="B1" bindtap="onFloorTap">🕳️ 地底一层</view>
      <view class="floor-tab {{activeFloor === 'B2' ? 'floor-on' : ''}}"
            data-floor="B2" bindtap="onFloorTap">🕳️ 地底二层</view>
    </view>

    <scroll-view scroll-x class="sub-scroll">
      <view class="sub-row">
        <view class="sub-chip {{activeSub === '全部' ? 'sub-on' : ''}}" data-sub="全部" bindtap="onSubTap">全部</view>
        <view class="sub-chip {{activeSub === item.name ? 'sub-on' : ''}}"
              wx:for="{{subs}}" wx:key="name"
              data-sub="{{item.name}}" bindtap="onSubTap">{{item.name}} {{item.count}}</view>
      </view>
    </scroll-view>

    <!-- 互动地图：canvas 尺寸随 zoom 缩放（标记百分比定位自动跟随） -->
    <movable-area class="map-area">
      <movable-view class="map-mover" direction="all" inertia out-of-bounds="{{false}}"
                    x="{{xPos}}" y="{{yPos}}">
        <view class="map-canvas" style="{{canvasStyle}}">
          <view class="tile-grid">
            <image class="tile" wx:for="{{tiles}}" wx:key="key" src="{{item.url}}" mode="scaleToFill"></image>
          </view>
          <view class="marker" wx:for="{{mapMarkers}}" wx:key="i"
                style="left: {{item.xPct}}%; top: {{item.yPct}}%;"
                data-i="{{index}}" catchtap="onMarkerTap">
            <image class="mk-icon" src="{{item.icon}}" mode="aspectFit"></image>
          </view>
        </view>
      </movable-view>
    </movable-area>

    <view class="info-bar" wx:if="{{selected}}">
      <view class="ib-close" bindtap="onClose">✕</view>
      <view class="ib-name">{{selected.name}}</view>
      <view class="ib-meta">{{selected.sub}} <text wx:if="{{selected.layer}}" class="ib-floor">· 楼层 {{selected.layer}}</text></view>
      <view class="ib-desc" wx:if="{{selected.desc}}">{{selected.desc}}</view>
    </view>
    <view class="info-bar ib-tip" wx:else>
      💡 拖动地图 · ±缩放 · 点标记看详情 · {{total}} 个点位
    </view>

  </block>

</view>