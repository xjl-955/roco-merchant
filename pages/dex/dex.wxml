<view class="page">

  <!-- 搜索 -->
  <view class="search-wrap">
    <input class="search" placeholder="请输入精灵名或编号进行搜索"
           value="{{keyword}}" bindinput="onSearchInput" />
  </view>

  <!-- 属性图标行 -->
  <view class="type-row">
    <view class="type-icon {{selType === item.name ? 'type-on' : ''}}"
          wx:for="{{typeIcons}}" wx:key="name"
          data-type="{{item.name}}" bindtap="onTypeIconTap">
      <view class="type-dot" style="background: {{item.color}}"></view>
      <view class="type-name">{{item.name}}</view>
    </view>
    <view class="type-icon {{showMoreTypes ? 'type-on' : ''}}" bindtap="onToggleMore">
      <view class="type-dot type-dot-more">···</view>
      <view class="type-name">更多</view>
    </view>
  </view>

  <!-- 更多属性展开 -->
  <view class="more-row" wx:if="{{showMoreTypes}}">
    <view class="type-pill" wx:for="{{moreTypes}}" wx:key="name"
          style="border-color: {{item.color}}; {{selType === item.name ? 'background:' + item.color + '33' : ''}}"
          data-type="{{item.name}}" bindtap="onTypeIconTap">{{item.name}}</view>
  </view>

  <!-- 第一行筛选：形态 / 异色 -->
  <view class="filter-row">
    <picker mode="selector" range="{{stages}}" value="{{stageIndex}}" bindchange="onStageChange">
      <view class="filter-btn">{{stages[stageIndex]}} ▾</view>
    </picker>
    <picker mode="selector" range="{{shinyOptions}}" value="{{shinyPickIndex}}" bindchange="onShinyPick">
      <view class="filter-btn {{shinyPickIndex > 0 ? 'filter-on' : ''}}">{{shinyOptions[shinyPickIndex]}} ▾</view>
    </picker>
    <picker mode="selector" range="{{seasons}}" value="{{seasonIndex}}" bindchange="onSeasonChange">
      <view class="filter-btn {{seasonIndex > 0 ? 'filter-on' : ''}}">{{seasons[seasonIndex]}} ▾</view>
    </picker>
  </view>

  <!-- 统计 -->
  <view class="meta-row">
    <view class="count-line">共 {{total}} 只</view>
  </view>

  <view class="state" wx:if="{{loading}}">⏳ 图鉴数据加载中…</view>
  <view class="state" wx:if="{{error}}">数据加载失败，下拉重试</view>

  <!-- 宫格（图卡 + 底部色块名条 + 编号 + 属性点） -->
  <view class="grid" wx:if="{{!loading && !error}}">
    <view class="cell" wx:for="{{list}}" wx:key="id"
          data-name="{{item.name}}" bindtap="onSpiritTap">
      <view class="cell-stage" wx:if="{{item.stageText}}">{{item.stageText}}</view>
      <view class="cell-imgwrap">
        <image class="cell-img" src="{{item.wikiImage || item.image}}" mode="aspectFit" lazy-load="true"></image>
        <view class="cell-no">{{item.no}}</view>
      </view>
      <view class="cell-namebar">
        <text class="cell-name">{{item.name}}</text>
        <view class="cell-types">
          <view class="cell-type" wx:for="{{item.types}}" wx:for-item="tp" wx:key="*this"
                style="background: {{item._colors[tp] || '#999'}}"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="end-tip" wx:if="{{!loading && !error && list.length >= total && total > 0}}">— 已全部加载 —</view>
</view>
