<view class="page">

  <view class="state" wx:if="{{loading}}">⏳ 加载中…</view>
  <view class="state" wx:if="{{notFound}}">未找到该精灵</view>

  <block wx:if="{{!loading && spirit}}">

    <!-- 基础信息条 -->
    <view class="card">
      <view class="sec">📋 基础信息</view>
      <view class="pills">
        <view class="pill"><text class="pill-k">属性</text><text class="pill-v" wx:for="{{spirit.types}}" wx:key="*this" style="color: {{typeColor[item]}}">{{item}}</text></view>
        <view class="pill" wx:if="{{spirit.stageText}}"><text class="pill-k">阶段</text><text class="pill-v">{{spirit.stageText}}</text></view>
        <view class="pill" wx:if="{{spirit.season && spirit.season !== 'none'}}"><text class="pill-k">赛季</text><text class="pill-v">{{spirit.season}}</text></view>
        <view class="pill" wx:if="{{detail.eggGroup}}"><text class="pill-k">蛋组</text><text class="pill-v">{{detail.eggGroup}}</text></view>
        <view class="pill" wx:if="{{detail.body}}"><text class="pill-k">身高</text><text class="pill-v">{{detail.body.h}}</text></view>
        <view class="pill" wx:if="{{detail.body}}"><text class="pill-k">体重</text><text class="pill-v">{{detail.body.w}}</text></view>
      </view>
    </view>

    <!-- 种族值 -->
    <view class="card" wx:if="{{statBars.length > 0}}">
      <view class="sec">✨ 种族值 <text class="sec-total" wx:if="{{detail.total}}">总和 {{detail.total}}</text></view>
      <view class="stat-row" wx:for="{{statBars}}" wx:key="key">
        <view class="stat-label">{{item.label}}</view>
        <view class="stat-bar-bg">
          <view class="stat-bar" style="width: {{item.pct}}%"></view>
        </view>
        <view class="stat-value">{{item.value}}</view>
      </view>
    </view>

    <!-- 特长概率 -->
    <view class="card" wx:if="{{detail.talents.length > 0}}">
      <view class="sec">🎴 特长概率</view>
      <view class="trait-row" wx:for="{{detail.talents}}" wx:key="name">
        <text class="trait-name">{{item.name}}</text>
        <text class="trait-p">{{item.p}}</text>
      </view>
    </view>

    <!-- 受击关系 -->
    <view class="card" wx:if="{{atkGroups}}">
      <view class="sec">🛡️ 受击关系（{{spirit.types[0]}}系）</view>
      <view class="g-block" wx:if="{{defGroups.x2.length}}">
        <view class="g-title t-x2">×2 弱点</view>
        <view class="chips"><text class="chip" wx:for="{{defGroups.x2}}" wx:key="*this">{{item}}</text></view>
      </view>
      <view class="g-block" wx:if="{{defGroups.x05.length}}">
        <view class="g-title t-x05">×0.5 抵抗</view>
        <view class="chips"><text class="chip" wx:for="{{defGroups.x05}}" wx:key="*this">{{item}}</text></view>
      </view>
      <view class="g-block" wx:if="{{atkGroups.x2.length}}">
        <view class="g-title t-x2">⚔️ 进攻 2倍克制</view>
        <view class="chips"><text class="chip" wx:for="{{atkGroups.x2}}" wx:key="*this">{{item}}</text></view>
      </view>
    </view>

    <!-- 技能表 -->
    <view class="card">
      <view class="sec">⚔️ 技能表</view>
      <view class="skill-tabs">
        <view class="stab {{skillSrc === index ? 'stab-on' : ''}}"
              wx:for="{{skillSrcList}}" wx:key="key"
              data-idx="{{index}}" bindtap="onSkillSrcTap">{{item.label}}</view>
      </view>
      <view class="skill" wx:for="{{skills}}" wx:key="name">
        <view class="skill-head">
          <text class="skill-name">{{item.name}}</text>
          <text class="skill-type" style="background: {{item.color}}33; color: {{item.color}}">{{item.type}}</text>
        </view>
        <view class="skill-meta">
          <text class="meta-chip" wx:if="{{item.lv}}">{{item.lv}}</text>
          <text class="meta-chip" wx:if="{{item.power && item.power !== '-'}}">威力 {{item.power}}</text>
          <text class="meta-chip" wx:if="{{item.cost}}">能耗 {{item.cost}}</text>
          <text class="meta-chip">{{item.cat}}</text>
        </view>
        <view class="skill-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
      </view>
      <view class="empty" wx:if="{{skills.length === 0}}">暂无该分类技能</view>
    </view>

  </block>

</view>
