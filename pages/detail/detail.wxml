<view class="page">

  <view class="state" wx:if="{{loading}}">⏳ 加载中…</view>
  <view class="state" wx:if="{{notFound}}">未找到该精灵（数据可能未同步，下拉图鉴页刷新试试）</view>

  <block wx:if="{{!loading && spirit}}">

    <!-- 头部卡片 -->
    <view class="card hero">
      <image class="hero-img" src="{{spirit.image}}" mode="aspectFit" lazy-load="true"></image>
      <view class="hero-info">
        <view class="hero-name">{{spirit.name}}</view>
        <view class="hero-no">{{spirit.no}} · {{spirit.stageLabel}}<text wx:if="{{spirit.shiny}}"> · 异色</text></view>
        <view class="hero-types">
          <text class="type-tag" wx:for="{{spirit.types}}" wx:key="*this"
                style="background: {{typeColor[item]}}33; border-color: {{typeColor[item]}};"
                data-type="{{item}}" bindtap="onCopyType">{{item}}</text>
        </view>
        <view class="hero-total" wx:if="{{spirit.total}}">种族值总和 <text class="total-num">{{spirit.total}}</text></view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="card">
      <view class="sec">📋 基本信息</view>
      <view class="kv"><text class="k">蛋组</text><text class="v">{{spirit.egg}}</text></view>
      <view class="kv"><text class="k">骑乘</text><text class="v">{{spirit.ride || '—'}}</text></view>
      <view class="kv"><text class="k">图鉴编号</text><text class="v">{{spirit.no}}</text></view>
      <view class="kv"><text class="k">形态</text><text class="v">{{spirit.stageLabel}}</text></view>
    </view>

    <!-- 进化链 -->
    <view class="card" wx:if="{{family.length > 1}}">
      <view class="sec">🔗 进化链 / 同族形态</view>
      <scroll-view scroll-x class="family-scroll">
        <view class="family-row">
          <view class="f-item {{item.name === spirit.name ? 'f-current' : ''}}"
                wx:for="{{family}}" wx:key="name"
                data-name="{{item.name}}" data-slug="{{item.slug}}" bindtap="onFamilyTap">
            <image class="f-img" src="{{item.image}}" mode="aspectFit" lazy-load="true"></image>
            <view class="f-name">{{item.name}}</view>
            <view class="f-stage">{{item.stageLabel}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 提示 -->
    <view class="card">
      <view class="sec">ℹ️ 说明</view>
      <view class="tip">· 点击属性标签可复制；点击进化链成员可切换查看</view>
      <view class="tip">· 详细技能表请看参照站：rocokingdomworld.org/zh/pokedex/{{spirit.slug}}/</view>
    </view>

  </block>

</view>
